{
  "root": true,
  "extends": "eslint:recommended",
  "env": {"browser": true, "es2021": true},
  "parserOptions": {"ecmaVersion": 2021},
  "globals": {"Drupal": "readonly", "once": "readonly", "jQuery": "readonly", "drupalSettings": "readonly"},
  "rules": {"eqeqeq": "error", "no-var": "error", "prefer-const": "error", "no-unused-vars": ["error", {"argsIgnorePattern": "^_"}]},
  "overrides": [{"files": ["tests/browser/*.cjs"], "env": {"node": true}}]
}
